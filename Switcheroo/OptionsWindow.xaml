<Window x:Class="Switcheroo.OptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Switcheroo 选项" ResizeMode="CanResize" MinWidth="520" MinHeight="480"
        Width="560" Height="620"
        ShowInTaskbar="False" WindowStyle="ToolWindow"
        Background="{DynamicResource WindowBackgroundBrush}">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0">
            <!-- ============ 触发方式 ============ -->
            <TabItem Header="触发">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="4,8,4,8">
                        <CheckBox Name="HotKeyCheckBox" Margin="5,5,5,1" Checked="HotKeyCheckBox_Checked" Unchecked="HotKeyCheckBox_OnUnchecked">用此快捷键激活 Switcheroo：</CheckBox>
                        <TextBox Name="HotkeyPreview" Margin="25,5,0,10"
                                 PreviewKeyDown="HotkeyPreview_OnPreviewKeyDown"
                                 GotFocus="HotkeyPreview_OnGotFocus"
                                 LostFocus="HotkeyPreview_OnLostFocus"
                                 Width="150" HorizontalAlignment="Left"/>
                        <CheckBox Name="AltTabCheckBox" Checked="AltTabCheckBox_OnChecked" Unchecked="AltTabCheckBox_OnUnchecked" Margin="5,5,5,1">用 Alt+Tab 激活 Switcheroo</CheckBox>
                        <TextBlock Margin="25,0,5,10" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap">
                            使用 Switcheroo 替代 Windows 内置的任务切换器。
                        </TextBlock>
                        <CheckBox Name="AutoSwitch" Margin="5,5,5,1">松开 Alt + Tab 时自动切换窗口</CheckBox>
                        <TextBlock Margin="25,0,5,10" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap">
                            在窗口间切换更快、更接近原生体验。<LineBreak />
                            <LineBreak />
                            使用 <Span FontFamily="Consolas" FontWeight="Bold">Ctrl + Alt + Tab</Span> 可在搜索已激活的状态下显示 Switcheroo；
                            或在 Switcheroo 浮层出现时按 <Span FontFamily="Consolas" FontWeight="Bold">Alt + S</Span>。
                        </TextBlock>
                        <CheckBox Name="SwitchOnSingleClickCheckBox" Margin="5,5,5,1">单击切换窗口</CheckBox>
                        <TextBlock Margin="25,0,5,10" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap">
                            若未勾选，需双击才能切换到窗口。
                        </TextBlock>
                        <TextBlock Margin="5,5,5,1">中键操作：</TextBlock>
                        <ComboBox Name="MiddleClickActionComboBox" Margin="25,5,0,5" Width="200" HorizontalAlignment="Left">
                            <ComboBoxItem Content="无操作" Tag="0"/>
                            <ComboBoxItem Content="关闭鼠标光标下的项目" Tag="1"/>
                            <ComboBoxItem Content="关闭高亮项目" Tag="2"/>
                        </ComboBox>
                        <StackPanel Orientation="Horizontal" Margin="5,10,5,1">
                            <CheckBox Name="MaxResultsCheckBox" VerticalAlignment="Center"
                                      Checked="MaxResultsCheckBox_Checked" Unchecked="MaxResultsCheckBox_Unchecked">
                                限制搜索结果数量：
                            </CheckBox>
                            <TextBox Name="MaxResultsBox" Width="50" Margin="10,0,0,0" VerticalAlignment="Center" PreviewTextInput="NumberValidationTextBox"/>
                        </StackPanel>
                        <TextBlock Margin="25,0,5,10" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap">
                            显示更少结果以提升性能。
                        </TextBlock>
                        <CheckBox x:Name="RunAsAdministrator" Margin="5,5,5,1" Content="以管理员身份运行 *"/>
                        <TextBlock Margin="25,0,5,10" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap">
                            若希望在使用更高权限的程序获得焦点时 Alt + Tab 仍可用，需要此选项。<LineBreak />
                            <Italic>* 需要重启 Switcheroo</Italic>
                        </TextBlock>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============ 显示 ============ -->
            <TabItem Header="显示">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="4,8,4,8">
                        <TextBlock TextWrapping="Wrap" Margin="5,5,5,1">常用进程显示的列数：</TextBlock>
                        <ComboBox Name="NumberOfAppColumnsComboBox" Margin="25,5,0,10" Width="150" HorizontalAlignment="Left">
                            <ComboBoxItem Content="0" Tag="0"/>
                            <ComboBoxItem Content="1" Tag="1"/>
                            <ComboBoxItem Content="2" Tag="2"/>
                            <ComboBoxItem Content="3" Tag="3"/>
                        </ComboBox>
                        <TextBlock TextWrapping="Wrap" Margin="5,5,5,1">基础列宽（像素）：</TextBlock>
                        <TextBox Name="ColumnWidth" Margin="25,5,0,10" Width="150" HorizontalAlignment="Left" />
                        <TextBlock Margin="5,5,5,1">主题：</TextBlock>
                        <ComboBox Name="ThemeComboBox" Margin="25,5,0,5" Width="150" HorizontalAlignment="Left" SelectionChanged="ThemeComboBox_SelectionChanged">
                            <ComboBoxItem Content="浅色" Tag="Light"/>
                            <ComboBoxItem Content="深色" Tag="Dark"/>
                            <ComboBoxItem Content="跟随系统" Tag="System"/>
                        </ComboBox>
                        <TextBlock Margin="25,0,5,10" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap">
                            选择配色主题。「跟随系统」会采用 Windows 的主题设置。
                        </TextBlock>
                        <Separator Margin="5,5,5,8"/>
                        <CheckBox x:Name="ThumbnailPreviewCheckBox" Margin="5,5,5,1" Content="显示窗口预览缩略图"/>
                        <TextBlock Margin="25,0,5,10" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap">
                            选中项旁边显示 DWM 实时缩略图；最小化窗口显示切换前的最后一帧快照。
                        </TextBlock>
                        <CheckBox x:Name="UsageRankingCheckBox" Margin="5,5,5,1" Content="按最近使用排序切换列表"/>
                        <Separator Margin="5,5,5,8"/>
                        <CheckBox x:Name="GroupByProcessCheckBox" Margin="5,5,5,1" Content="同程序多窗口折叠（显示为一条 + ×N）"/>
                        <TextBlock Margin="25,0,5,10" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap">
                            折叠后预览窗会把该组的所有窗口一起铺出来。
                        </TextBlock>
                        <CheckBox x:Name="GroupCycleCheckBox" Margin="25,2,5,1" Content="组内轮换：Ctrl + Tab 切到组内下一个窗口"/>
                        <TextBlock Margin="45,0,5,10" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap">
                            不勾选 = 保持 Windows 原生手感（连按 Alt + Tab 只是移动选择，不在组内轮换）。
                        </TextBlock>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============ 名单与规则 ============ -->
            <TabItem Header="名单与规则">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="4,8,4,8">
                        <CheckBox x:Name="UseWindowRulesCheckBox" Margin="5,5,5,1" Content="启用窗口规则（隐藏 / 置顶 / 让路）"/>
                        <TextBlock Margin="25,0,5,12" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap">
                            规则可在「设置高亮」对话框里指定动作；关掉后只保留旧的黑名单与让路名单。
                        </TextBlock>
                        <CheckBox x:Name="PassThroughSuggestCheckBox" Margin="5,5,5,1" Content="让路建议（切走后被抢回前台时提示加入让路名单）"/>
                        <TextBlock Margin="25,0,5,12" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap">
                            名单本身在托盘菜单「让路名单」里查看与移除，或右键窗口「让路（不接管 Alt+Tab）」加入。
                        </TextBlock>
                        <CheckBox x:Name="ConfigExportCheckBox" Margin="5,5,5,1" Content="托盘提供配置导出/导入（JSON）"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============ 诊断 ============ -->
            <TabItem Header="诊断">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="4,8,4,8">
                        <CheckBox x:Name="DiagLogCheckBox" Margin="5,5,5,1" Content="记录诊断日志 *"/>
                        <TextBlock Margin="25,0,5,12" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap">
                            写到 %AppData%\Switcheroo\diag\yyyyMMdd.log，只在排查问题时需要。<LineBreak />
                            <Italic>* 需要重启 Switcheroo</Italic>
                        </TextBlock>
                        <CheckBox x:Name="HookWatchdogCheckBox" Margin="5,5,5,1" Content="钩子看门狗 *"/>
                        <TextBlock Margin="25,0,5,12" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap">
                            检测到按键漏给前台程序时自动重装低级键盘钩子。<LineBreak />
                            <Italic>* 需要重启 Switcheroo</Italic>
                        </TextBlock>
                        <CheckBox x:Name="CommandLineCheckBox" Margin="5,5,5,1" Content="命令行接口（--show / --switch）*"/>
                        <TextBlock Margin="25,0,5,12" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap">
                            switcheroo.exe --switch "微信" 可直接切换；供 Quicker / AHK / 脚本调用。<LineBreak />
                            <Italic>* 需要重启 Switcheroo</Italic>
                        </TextBlock>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Grid Grid.Row="1" Margin="5,10,5,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Name="Ok" Width="72" Click="Ok_Click" IsDefault="True" Margin="0,0,10,0" Grid.Column="1">确定</Button>
            <Button Name="Cancel" Width="72" Click="Cancel_Click" IsCancel="True" Grid.Column="2">取消</Button>
        </Grid>
    </Grid>
</Window>
